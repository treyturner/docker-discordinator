@@ -0,0 +1,21 @@
+import { scalar } from './text.js';
+
+/** Keep wildcard bind addresses separate from addresses local clients can connect to. */
+export function localListenerHost(value: unknown): string {
+    const host = scalar(value) || '127.0.0.1';
+    if (host === '0.0.0.0') return '127.0.0.1';
+    if (host === '::') return '::1';
+    return host;
+}
+
+function httpAddress(host: string, port: unknown): string {
+    return `http://${host.includes(':') ? `[${host}]` : host}:${scalar(port) || '8787'}`;
+}
+
+export function listenerUrl(environment: Record<string, unknown>): string {
+    return httpAddress(scalar(environment.DISCORDINATOR_BIND_HOST) || '127.0.0.1', environment.DISCORDINATOR_PORT);
+}
+
+export function localListenerUrl(environment: Record<string, unknown>): string {
+    return httpAddress(localListenerHost(environment.DISCORDINATOR_BIND_HOST), environment.DISCORDINATOR_PORT);
+}
